# Copy to .env.local for `npm run dev`; on Vercel, add each in Settings →
# Environment Variables. README: Setup.

# Signing in: your password (8+ characters; longer is better), and a random
# string of 32+ characters that signs the sign-in cookie (changing it signs
# everyone out). Make one with: openssl rand -base64 32
APP_PASSWORD=
SESSION_SECRET=

# The Supabase project (Project Settings → API): its URL and its secret
# key (the "service_role" or "sb_secret_…" key). Never shown in the browser.
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# The app's address, e.g. https://post-planner.vercel.app (the networks' callback URLs use it).
APP_URL=

# Any long random string. The every-minute run sends it (Accounts → Scheduled posts).
CRON_SECRET=

# Each network: an app made on its developer site (Accounts says where, and
# the callback URL to register). Leave a pair empty to skip that network.
X_CLIENT_ID=
X_CLIENT_SECRET=
META_APP_ID=
META_APP_SECRET=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=

# Optional
# "1" once LinkedIn approves the Community Management API: company pages and their numbers.
LINKEDIN_PAGES=
# Only if a network says the version is too old.
META_GRAPH_VERSION=
LINKEDIN_API_VERSION=
